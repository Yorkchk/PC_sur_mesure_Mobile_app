<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/burgundyred"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/uottawalogo2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="150dp"
        android:src="@drawable/uottawalogo"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="28dp"
        android:layout_marginBottom="-20dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="28dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uottawa Hardware"
                android:textColor="@color/burgundy"
                android:fontFamily="@font/sofia2"
                android:textSize="32dp">

            </TextView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please login with your information"
                android:textColor="@color/burgundy"
                android:alpha="0.5">

            </TextView>
            
            <View
                android:layout_width="wrap_content"
                android:layout_height="30dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/Emaillogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/baseline_check_24"/>

            <View
                android:layout_width="wrap_content"
                android:layout_height="30dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/baseline_remove_red_eye_24"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember me"
                android:textColor="@color/burgundy"
                android:layout_centerVertical="true"
                android:alpha="0.7"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot password"
                android:textColor="@color/burgundy"
                android:alpha="0.7"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>




        </RelativeLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="20dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@id/login_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Login"
            app:cornerRadius="50dp">

        </com.google.android.material.button.MaterialButton>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="17.5dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---------------------------------------- or ---------------------------------------"
                android:textColor="@color/burgundy"
                app:layout_constraintStart_toStartOf="@+id/login_button"
                app:layout_constraintEnd_toEndOf="@+id/login_button"
                android:alpha="0.5"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="17.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@id/signupbtn"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:text="Sign up"
                app:cornerRadius="50dp">

            </com.google.android.material.button.MaterialButton>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>






