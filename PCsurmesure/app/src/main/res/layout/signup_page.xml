<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/burgundyred"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/uottawalogo2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="150dp"
        android:src="@drawable/uottawalogo"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="28dp"
        android:layout_marginBottom="-20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="28dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uottawa Hardware Sign up"
                android:textColor="@color/burgundy"
                android:fontFamily="@font/sofia2"
                android:textSize="28dp">

            </TextView>
            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="It's quick and easy! Uottawa Hardware is about computing tailored to you."
                android:textColor="@color/burgundy"
                android:alpha="0.5">

            </TextView>

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="First Name                                       Last Name"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/firstName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="First Name"
                    android:textColorHint="@color/burgundy"
                    android:textColor="@color/burgundy"
                    android:layout_centerVertical="true"
                    android:alpha="0.7"/>
                <EditText
                    android:id="@+id/lastName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Last Name"
                    android:textColorHint="@color/burgundy"                    android:textColor="@color/burgundy"
                    android:alpha="0.7"
                    android:layout_marginLeft="200dp"
                    android:layout_centerVertical="true"/>




            </RelativeLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                android:textColorHint="@color/burgundy"
                android:textColor="@color/burgundy"
                android:inputType="textEmailAddress"
                android:drawableEnd="@drawable/baseline_check_24"/>

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:textColorHint="@color/burgundy"
                android:textColor="@color/burgundy"
                android:inputType="textEmailAddress"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/signuPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Password"
                android:textColorHint="@color/burgundy"
                android:textColor="@color/burgundy"
                android:drawableEnd="@drawable/baseline_remove_red_eye_24"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="@color/burgundy"
                android:alpha="0.5"/>
            <EditText
                android:id="@+id/confPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/burgundy"
                android:hint="Confirm Password"
                android:textColorHint="@color/burgundy"
                android:inputType="textPassword"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


            </RelativeLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="3dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/signupbtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Sign up"
                app:cornerRadius="50dp">

            </com.google.android.material.button.MaterialButton>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="17.5dp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="17.5dp" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>