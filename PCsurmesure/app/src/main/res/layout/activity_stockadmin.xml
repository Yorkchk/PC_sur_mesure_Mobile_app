<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/burgundyred">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:background="#94000000"
        android:padding="5dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/sofia2"
            android:textAlignment="center"
            android:layout_marginTop="10dp">

        </TextView>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="65dp">
            <LinearLayout
                android:layout_width="370dp"
                android:layout_height="100dp"
                android:background="@drawable/white_curvy"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:padding="3dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete Database"
                        android:textColor="@color/burgundy"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="15dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete Requesters, Stock, Commands   "
                        android:textColor="@color/burgundy"
                        android:textSize="15sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/deletebutton"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:text="Delete"
                    android:textSize="18dp"
                    android:padding="8dp"
                    android:src="@drawable/baseline_add_24">

                </Button>
            </LinearLayout>
            <LinearLayout
                android:layout_width="370dp"
                android:layout_height="100dp"
                android:background="@drawable/white_curvy"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:padding="3dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reinitialize database"
                        android:textColor="@color/burgundy"
                        android:textStyle="bold"
                        android:textSize="23sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="15dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Override all Requesters and Stock"
                        android:textColor="@color/burgundy"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/overrideDataBase"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginLeft="45dp"
                    android:padding="8dp"
                    android:src="@drawable/baseline_create_24">

                </ImageButton>
            </LinearLayout>
            <LinearLayout
                android:layout_width="370dp"
                android:layout_height="100dp"
                android:background="@drawable/white_curvy"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:padding="3dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reinitialize Stock     "
                        android:textColor="@color/burgundy"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="15dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Override Stock"
                        android:textColor="@color/burgundy"
                        android:textSize="15sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/OverrideStock"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:padding="8dp"
                    android:src="@drawable/baseline_add_24">

                </ImageButton>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</RelativeLayout>